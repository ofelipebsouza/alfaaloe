---
import { SITE, BUSINESS, getCanonicalUrl } from '../lib/seo-config';

export interface Props {
  // Legacy page types receive basic website metadata, not unverified rich results.
  type?: 'website' | 'article' | 'faq' | 'product' | 'localBusiness' | 'breadcrumb';
  title?: string;
  description?: string;
  url?: string;
  image?: string;
  publishedAt?: string;
  modifiedAt?: string;
  author?: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
  articleBody?: string;
}

const {
  type = 'website',
  title = SITE.name,
  description = BUSINESS.description,
  url = Astro.url.pathname,
  image,
  publishedAt,
  modifiedAt,
  author = SITE.author,
  breadcrumbs = [],
  articleBody,
} = Astro.props;

const canonicalUrl = getCanonicalUrl(url);
const organizationId = `${SITE.url}/#organization`;
const websiteId = `${SITE.url}/#website`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': organizationId,
  name: SITE.name,
  url: `${SITE.url}/`,
  description: BUSINESS.description,
  telephone: BUSINESS.telephone,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': websiteId,
  name: SITE.name,
  url: `${SITE.url}/`,
  description: BUSINESS.description,
  inLanguage: SITE.language,
  publisher: { '@id': organizationId },
};

const schemas: object[] = [organizationSchema, websiteSchema];

if (type === 'article') {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': `${canonicalUrl}#article`,
    headline: title,
    description,
    url: canonicalUrl,
    ...(image ? { image: new URL(image, `${SITE.url}/`).href } : {}),
    ...(publishedAt ? { datePublished: publishedAt } : {}),
    ...(modifiedAt ? { dateModified: modifiedAt } : {}),
    author: author === SITE.author
      ? { '@id': organizationId }
      : { '@type': 'Person', name: author },
    publisher: { '@id': organizationId },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
    ...(articleBody ? { articleBody } : {}),
    inLanguage: SITE.language,
  });
}

if (breadcrumbs.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: getCanonicalUrl(crumb.url),
    })),
  });
}

// Escaping '<' prevents content from terminating the JSON-LD script element.
const jsonLd = JSON.stringify(schemas).replace(/</g, '\\u003c');
---

<script type="application/ld+json" set:html={jsonLd} />
