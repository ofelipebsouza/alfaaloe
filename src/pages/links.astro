---
import Layout from '../layouts/Layout.astro';
import LinksPage from '../sections/LinksPage';
import '../styles/brand-pages.css';
import { getCanonicalUrl } from '../lib/seo-config';
const breadcrumbs = [
  { name: 'Início', url: getCanonicalUrl('/') },
  { name: 'Links', url: getCanonicalUrl('/links') },
];
---
<Layout title="Alfa Aloe | Catálogo e WhatsApp" description="Os caminhos para encontrar seu próximo cuidado. Explore os produtos Forever no catálogo da Alfa Aloe ou converse pelo WhatsApp." schemaBreadcrumbs={breadcrumbs}>
  <LinksPage client:load />
</Layout>
